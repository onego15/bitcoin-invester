# OpenAI API Key
# 社内プロキシを使用する場合は、プロキシから取得したAPIキーを設定
# 形式: ok-****** (社内プロキシの場合)
OPENAI_API_KEY=your-api-key-here

# OpenAI API Base URL (オプション)
# 社内プロキシを使用する場合は以下のように設定
# 例: https://openai-proxy-apigw-genai.api.linecorp.com/v1
OPENAI_API_BASE=https://openai-proxy-apigw-genai.api.linecorp.com/v1

# User ID (オプション、プロキシ用)
# 社員IDなどを設定
OPENAI_USER_ID=your-employee-id

# Application Title (オプション、プロキシ用)
# アプリケーション識別子
OPENAI_APP_TITLE=BitcoinInvester
